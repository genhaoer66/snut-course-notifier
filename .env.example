# ============================================================
#  课表推送 —— 配置模板
#
#  使用方法：把本文件复制一份改名为 .env，然后填写真实值。
#  .env 已被 .gitignore 忽略，不会上传到任何地方。
#
#  复制命令（在项目根目录执行）：
#      cp .env.example .env
# ============================================================


# ---------- 陕西理工大学统一身份认证 ----------
# 就是登录 newehall / jwgl 时用的那套账号
SNUT_USERNAME=你的学号
SNUT_PASSWORD=你的密码


# ---------- 邮件推送 ----------
# 【重要】下面填的是 SMTP 授权码，不是你的 QQ 登录密码！
# 获取步骤：
#   1. 打开 https://mail.qq.com 登录
#   2. 顶部「设置」→「账户」
#   3. 找到「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务」
#   4. 开启「IMAP/SMTP服务」→ 按提示发短信验证
#   5. 弹出的那串 16/32 位字母就是授权码，只显示一次，记好
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ号@qq.com
SMTP_AUTH_CODE=你的SMTP授权码

# 收件邮箱。想发给自己就填和上面一样的地址
MAIL_TO=你的QQ号@qq.com
# 邮件里显示的发件人名字
MAIL_FROM_NAME=课表小助手


# ---------- 网站访问口令 ----------
# 部署网站后，同学打开 https://你的域名 需要输入的密码。
#
# 留空 = 网站完全公开，谁拿到链接都能看。
# 填上 = 只有知道这个口令的人能看（浏览器会记住，不用每次输）。
#
# 注意这是一道「挡陌生人」的共享口令，不是账号体系：
# 全班同学共用一个，发给谁就等于允许谁看。
# 口令会走 HTTPS 传给服务器，不会明文过网。
WEB_PASSWORD=


# ---------- 可选：微信推送 ----------
# 不填就不启用，只发邮件。
# 想启用的话去 https://sct.ftqq.com 微信扫码，把 SendKey 填这里
SERVERCHAN_KEY=


# ---------- 其他 ----------
# 学校系统地址（一般不用改）
EAMS_BASE=http://jwgl.snut.edu.cn/eams
AUTH_BASE=https://authserver.snut.edu.cn/authserver

# 请求超时秒数
HTTP_TIMEOUT=60

# 两次请求之间的最小间隔（秒）。
# 学校 EAMS 有防刷机制，请求过密会返回"请不要过快点击"而不是数据。
# 建议不低于 2，稳妥起见用 3。
REQUEST_INTERVAL=3

# 调试模式：设为 1 会把抓到的原始响应存到 logs/ 下，方便排查
DEBUG_SAVE_RAW=0

# ---------- 学期与网站 ----------
# 本学期第 1 周周一。学校系统不提供这个接口，需要每学期手动维护。
SEMESTER_START=2026-08-31
