# ============================================
# 敏感配置 —— 绝对不要提交！
# .env 里含学号、密码、邮箱授权码
# ============================================
.env
.env.local
.env.*.local

# 本地 AI/编辑器工作说明，不属于项目源码
.claude/
.codex/
AGENTS.md
CLAUDE.md

# 但配置模板需要提交，方便换电脑时复用
!.env.example

# ============================================
# 登录会话缓存（含 Cookie，等同于登录凭证）
# ============================================
.session/
*.session
cookies*.txt

# ============================================
# 日志（可能含课表等个人信息）
# ============================================
logs/
*.log

# ============================================
# 课表快照（网站读的数据）
# 本身已脱敏，但它是运行产物不是源码，没必要进版本库
# ============================================
data/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
